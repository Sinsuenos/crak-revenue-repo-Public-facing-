{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./crak-revenue-repo-Public-facing-/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "crak-revenue-repo-Public-facing-/app/**/*.ts",
    "crak-revenue-repo-Public-facing-/app/**/*.tsx",
    "crak-revenue-repo-Public-facing-/lib/**/*.ts",
    "crak-revenue-repo-Public-facing-/lib/**/*.tsx",
    "crak-revenue-repo-Public-facing-/data/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
